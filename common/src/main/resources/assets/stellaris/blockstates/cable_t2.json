{
  "multipart": [
    {
      "apply": {
        "model": "stellaris:block/cable/t2/cable_t2"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t2/cable_north_t2",
        "uvlock": true
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t2/cable_east_t2",
        "uvlock": true
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t2/cable_south_t2",
        "uvlock": true
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t2/cable_west_t2",
        "uvlock": true
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t2/cable_up_t2",
        "uvlock": true
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t2/cable_down_t2",
        "uvlock": true
      },
      "when": {
        "down": "true"
      }
    }
  ]
}