{
  "multipart": [
    {
      "apply": {
        "model": "stellaris:block/pipe/t3/pipe_t3"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t3/pipe_north_t3",
        "uvlock": true
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t3/pipe_east_t3",
        "uvlock": true
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t3/pipe_south_t3",
        "uvlock": true
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t3/pipe_west_t3",
        "uvlock": true
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t3/pipe_up_t3",
        "uvlock": true
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t3/pipe_down_t3",
        "uvlock": true
      },
      "when": {
        "down": "true"
      }
    }
  ]
}