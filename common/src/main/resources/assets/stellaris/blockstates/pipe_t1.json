{
  "multipart": [
    {
      "apply": {
        "model": "stellaris:block/pipe/t1/pipe_t1"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t1/pipe_north_t1",
        "uvlock": true
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t1/pipe_east_t1",
        "uvlock": true
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t1/pipe_south_t1",
        "uvlock": true
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t1/pipe_west_t1",
        "uvlock": true
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t1/pipe_up_t1",
        "uvlock": true
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/pipe/t1/pipe_down_t1",
        "uvlock": true
      },
      "when": {
        "down": "true"
      }
    }
  ]
}