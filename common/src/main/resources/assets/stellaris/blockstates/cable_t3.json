{
  "multipart": [
    {
      "apply": {
        "model": "stellaris:block/cable/t3/cable_t3"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t3/cable_north_t3",
        "uvlock": true
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t3/cable_east_t3",
        "uvlock": true
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t3/cable_south_t3",
        "uvlock": true
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t3/cable_west_t3",
        "uvlock": true
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t3/cable_up_t3",
        "uvlock": true
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "stellaris:block/cable/t3/cable_down_t3",
        "uvlock": true
      },
      "when": {
        "down": "true"
      }
    }
  ]
}